{
    "id": "digilux-dev-env-2025",
    "name": "Digilux — Dev (AWS)",
    "values": [
        {
            "key": "api_id",
            "value": "YOUR_API_GATEWAY_ID",
            "type": "default",
            "enabled": true,
            "description": "API Gateway REST API ID from the AWS console (e.g. abc123xyz)"
        },
        {
            "key": "stage",
            "value": "dev",
            "type": "default",
            "enabled": true,
            "description": "Deployment stage"
        },
        {
            "key": "cognito_client_id",
            "value": "YOUR_COGNITO_APP_CLIENT_ID",
            "type": "default",
            "enabled": true,
            "description": "Cognito User Pool App Client ID"
        },
        {
            "key": "test_username",
            "value": "testuser@digilux.com",
            "type": "default",
            "enabled": true,
            "description": "Cognito test user email"
        },
        {
            "key": "test_password",
            "value": "",
            "type": "secret",
            "enabled": true,
            "description": "Cognito test user password — store as secret, do not commit"
        },
        {
            "key": "admin_token",
            "value": "",
            "type": "secret",
            "enabled": true,
            "description": "Admin JWT — obtain separately from your admin auth flow"
        }
    ],
    "_postman_variable_scope": "environment",
    "info": {
        "description": "AWS Dev environment for the Digilux Account Deletion API.\n\nSensitive values (test_password, admin_token) are marked as 'secret' — Postman will not sync them to the cloud. Set them locally only."
    }
}
